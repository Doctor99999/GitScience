# Deployer private key (no 0x prefix required). KEEP SECRET.
PRIVATE_KEY=

# JSON-RPC endpoint for the target network (Polygon / Base / Sepolia...).
RPC_URL=

# Etherscan/blockscout API key for contract verification (optional).
ETHERSCAN_API_KEY=

# Protocol founder wallet (default = canonical founder from PROTOCOL_CONSTANTS.json).
FOUNDER_WALLET=0x71C2B09934D3E08A52e52d7da7DAbFAc484EFE37

# Infrastructure pool recipient (15% share). MUST be supplied — no default.
INFRASTRUCTURE_POOL=
