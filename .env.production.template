# ==========================================
# GITSCIENCE ENTERPRISE: PRODUCTION ENV FILE
# ==========================================

# 1. DATABASE SECRETS (Change these!)
POSTGRES_PASSWORD=Enter_A_Secure_Password_Here_2026
REDIS_PASSWORD=Enter_A_Secure_Redis_Password_Here_2026

# 2. CRYPTOGRAPHIC SECRETS
# Used for Scholar Passport JWT signing. Make this long and random.
JWT_SECRET=YOUR_SUPER_SECRET_RANDOM_STRING_CHANGE_ME

# Bootstrap secret for the FIRST editorial admin (editor_in_chief / platform_admin).
# Once an admin exists, you may revoke it (physically delete this line).
# Bootstrap only grants elevated roles to the caller's OWN ORCID (verified by JWT).
# Sending it requires header: X-GS-Bootstrap-Secret: <value>
GS_EDITORIAL_BOOTSTRAP_SECRET=ENTER_A_LONG_RANDOM_BOOTSTRAP_SECRET

# 3. EXTERNAL INTEGRATIONS: ORCID OAUTH
# Get these from https://orcid.org/developer-tools
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 4. EXTERNAL STORAGE: AWS S3 / CLOUDFLARE R2
# Mandatory for storing 50MB PDF manuscripts in production
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=gitscience-vault
# Example for Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL=https://your-endpoint.com
AWS_REGION=auto

# 5. DOMAIN ROUTING
ALLOWED_ORIGINS=https://gitscience.org,https://www.gitscience.org
