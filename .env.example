# GitScience™ Sovereign Protocol Environment Configuration
# Скопируйте этот файл в .env перед запуском в продакшене

# ============================================================
# База данных
# ============================================================
# Локальная разработка (SQLite, по умолчанию если DATABASE_URL не задан):
# DATABASE_URL не задаётся — система автоматически используeт SQLite

# Production (PostgreSQL):
# DATABASE_URL=postgresql://gitscience:gitscience_password@db:5432/gitscience_db

# ============================================================
# Безопасность и JWT
# ============================================================
# ОБЯЗАТЕЛЬНО замените на собственный секрет (минимум 32 байта):
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_python_secrets_token_hex_32

# ============================================================
# Разрешённые CORS-источники (через запятую)
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gitscience.org

# ============================================================
# Web3 RPC эндпоинты
# ============================================================
POLYGON_RPC_URL=https://polygon-rpc.com
BASE_RPC_URL=https://mainnet.base.org

# ============================================================
# Облачное хранилище (AWS S3 / Cloudflare R2)
# ============================================================
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_BUCKET_NAME=gitscience-vault
# AWS_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
# AWS_REGION=auto

# ============================================================
# IPFS Gateway & Pinata (опционально)
# ============================================================
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ============================================================
# Локальное хранилище (переопределяет путь по умолчанию)
# ============================================================
# GITSCIENCE_STORAGE_PATH=/data/gitscience_vault
